# Wachtwoord om in te loggen (verplicht). Mag platte tekst zijn, of een hash van
# `php bin/hash-password.php` — zet een hash dan tussen enkele quotes: '$2y$10$...'
APP_PASSWORD=verander-mij

# MySQL / MariaDB. Op webhosting is dit meestal localhost, en hebben database
# en gebruiker vaak een voorvoegsel, bijv. account_books.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=books
DB_USER=books
DB_PASSWORD=verander-mij-ook

# Openbare alleen-lezen pagina op / (nu aan het lezen + gelezen per jaar)
PUBLIC_PAGE=true
# Het adres van je site, voor links in de RSS-feed, previews en {url} in toots.
APP_URL=https://lezen.example.nl

# Titel van de openbare pagina
PUBLIC_TITLE=Wat ik lees
PUBLIC_SHOW_REVIEWS=true

# Mastodon (Voorkeuren -> Ontwikkelaars -> Nieuwe applicatie, scopes write:statuses + read:accounts)
MASTODON_INSTANCE=mastodon.social
MASTODON_ACCESS_TOKEN=
# public, unlisted, private of direct
MASTODON_VISIBILITY=public
# De cover van het boek als afbeelding (met alt-tekst) bij de toot?
MASTODON_ATTACH_COVER=true
# Vinkje "Post naar Mastodon" standaard aan?
MASTODON_POST_BY_DEFAULT=true
# Optioneel: eigen teksten. Gebruik \n voor een nieuwe regel.
# Velden: {title} {author} {stars} {rating} {review} {isbn} {url}, en bij voortgang {percent} {page} {pages}
#MASTODON_TEMPLATE_FINISHED="📖 Uitgelezen: {title} – {author}\n{stars}\n\n{review}\n\n#boeken #bookstodon"
#MASTODON_TEMPLATE_STARTED="📚 Begonnen aan: {title} – {author}\n\n#boeken #bookstodon"

# Alleen nodig achter een eigen reverse proxy (bijv. nginx of Caddy die doorstuurt
# naar deze app): het IP-adres of de range (CIDR) van die proxy, kommagescheiden.
# Dan ziet de inlogbeperking het echte IP van bezoekers. Op gewone webhosting leeg laten.
TRUSTED_PROXIES=

# Bronnen voor boekgegevens en covers, in volgorde; elke bron vult aan wat de
# vorige mist. kb = Koninklijke Bibliotheek (Nederlandse boeken, geen covers);
# wikidata = alleen de serie en het deel. Laat een bron weg om hem niet te gebruiken.
METADATA_SOURCES=kb,openlibrary,google,wikidata
COVER_SOURCES=openlibrary,google
# Optioneel, als Google Books "te veel verzoeken" geeft: een gratis API-sleutel.
GOOGLE_BOOKS_API_KEY=

# Back-ups via cron (php bin/backup.php): waar, en hoeveel bewaren.
#BACKUP_DIR=/pad/buiten/je/website/backups
BACKUP_KEEP=14

# Zet tijdelijk op true om bij een fout de technische melding te zien. Daarna weer uit!
APP_DEBUG=false
