<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php" colors="true" failOnWarning="true">
  <testsuites>
    <testsuite name="all"><directory>tests</directory></testsuite>
  </testsuites>
  <php>
    <!-- Integration tests use this database and wipe it. Skipped when unreachable. -->
    <env name="TEST_DB_HOST" value="127.0.0.1"/>
    <env name="TEST_DB_NAME" value="books_test"/>
    <env name="TEST_DB_USER" value="books"/>
    <env name="TEST_DB_PASSWORD" value="books"/>
  </php>
</phpunit>
